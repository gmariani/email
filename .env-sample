# production | development
APP_ENV=production
# Public URL of the site; used in the User-Agent sent to geolocation services.
APP_URL=https://mariani.life/projects/email/

# Google Maps JavaScript API key (restrict it to your domain in the Google Cloud console).
GOOGLE_MAPS=""
# Google Analytics measurement id; leave empty to load no analytics.
GOOGLE_ANALYTICS=""
# Domain Inspector, linked from every domain shown (the domain is appended). Empty to disable.
DOMAIN_INSPECTOR_URL=https://mariani.life/projects/dns/

# Development only: load the front-end from the Vite dev server (npm run dev).
# VITE_DEV_SERVER=http://localhost:5173

# --- Geolocation -----------------------------------------------------------
# ipinfo.io token (https://ipinfo.io/account/token). Used first while it has quota;
# when it hits its limit (HTTP 429) lookups use the local database for an hour.
IP_INFO=""
# Local databases downloaded by `php app/bin/update-geoip.php` (defaults shown).
# GEOIP_CITY_DB=storage/geoip/dbip-city-lite.mmdb
# GEOIP_ASN_DB=storage/geoip/dbip-asn-lite.mmdb
# When those files are missing: "ip-api" (free, rate limited) or "none".
GEO_FALLBACK=ip-api

# --- DNS -------------------------------------------------------------------
# Recursive resolvers for reverse DNS and relay host names.
# DNS_RESOLVERS=1.1.1.1,8.8.8.8,9.9.9.9

# --- Abuse protection --------------------------------------------------------
# API calls per client IP, per RATE_LIMIT_WINDOW seconds:
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=600
# API calls allowed per page load (one per analysed email), and how long a page's token lasts.
RATE_LIMIT_PER_TOKEN=60
TOKEN_TTL=7200
# Behind Cloudflare or another proxy, the header carrying the real client IP:
# CLIENT_IP_HEADER=CF-Connecting-IP
