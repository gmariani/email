# Only index.php, api.php and the built front-end (build/) should be reachable.
# app/ (server code + vendor), storage/ (caches, GeoIP databases) and .env stay private.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(app|storage|frontend|node_modules|dist|tests|scripts)(/|$) - [F,L]
</IfModule>

<FilesMatch "^(\.env.*|composer\.(json|lock)|package(-lock)?\.json|vite\.config\.ts|tsconfig\.json|phpunit\.xml\.dist|\.user\.ini|.*\.md)$">
    Require all denied
</FilesMatch>
